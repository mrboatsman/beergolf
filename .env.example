# Drizzle
DATABASE_URL=./data/beergolf.db

# Fil-lagring (bevis för praktiskt prov)
# fs = lokala filsystemet (dev), s3 = AWS S3 (produktion, ej implementerad ännu)
STORAGE_DRIVER=fs
UPLOAD_DIR=./data/uploads

# adapter-node: höj gränsen för request-body så videouppladdningar går igenom (256 MB)
BODY_SIZE_LIMIT=268435456

# Stripe (turneringarnas anmälningsavgifter) — test mode-nycklar i dev
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
